rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Usernames Collection (Guarantees unique username reservation)
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && username.size() >= 3
                    && username.size() <= 30;
      allow update: if false; // Cannot transfer reserved usernames
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 64;
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid', 'createdAt', 'email', 'admin']);
      allow delete: if isOwner(userId) || isAdmin();

      // Following & Followers subcollections
      match /following/{targetUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /followers/{followerUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(followerUid);
      }

      // Bookmarks (private to user)
      match /bookmarks/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications (private to user)
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      // Blocked & Muted lists
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }
      match /mutes/{mutedUid} {
        allow read, write: if isOwner(userId);
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.content.size() <= 300;
      allow update: if isAuthenticated() && (
        isOwner(resource.data.authorId) ||
        // Allow counter increments via transactions
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'repostsCount', 'repliesCount', 'quotesCount'])
      );
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      // Likes subcollection
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Reposts subcollection
      match /reposts/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Replies subcollection
      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }

    // Private Conversations (1-on-1 and group)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated()
                     && request.auth.uid == request.resource.data.senderId
                     && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // Custom Feeds
    match /feeds/{feedId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Moderation Reports (strictly protected)
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
